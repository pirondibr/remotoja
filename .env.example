# Demo / funil — DataForSEO Google Jobs
DATAFORSEO_USER=
DATAFORSEO_PASS=

# Dashboard pago — multi-portal
SCRAPINGBEE_API_KEY=
TINYFISH_API_KEY=
SERPAPI_KEY=

# Postgres — cache de vagas + log de leads
# Use Neon (console.neon.tech) ou Render Postgres External URL (sslmode=require)
DATABASE_URL=

# Painel /admin — senha do login em /admin
ADMIN_SECRET=

# Assinatura / cookie de membro (fallback: ADMIN_SECRET)
MEMBER_SECRET=

# Mercado Pago — Checkout Brick (padrão) + Pro v1 de backup
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Use a Public Key do MESMO app do Access Token.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Força o checkout antigo: NEXT_PUBLIC_CHECKOUT_UI=v1
# Teste rápido no funil: /onboard?checkout=v1  ou  /onboard?checkout=brick
NEXT_PUBLIC_APP_URL=https://minhavagaremota.com.br

# Meta Pixel + Conversion API (Purchase / InitiateCheckout)
# Events Manager → Pixel → Configurações → API de Conversões
NEXT_PUBLIC_META_PIXEL_ID=1882197579413422
META_CAPI_ACCESS_TOKEN=
# Opcional: código de Test Events no painel (só em staging)
# META_CAPI_TEST_EVENT_CODE=

# OpenRouter — classificação de cargo + remoto na análise admin (modelo barato)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# URL secreta de teste do feed pago (só você):
#   https://minhavagaremota.com.br/lab?k=SEU_SEGREDO&role=seo
#   https://minhavagaremota.com.br/app?k=SEU_SEGREDO&role=seo
DEMO_ACCESS_SECRET=

# Força feed aberto mesmo com tokens configurados (dev)
# CHECKOUT_BYPASS=1
